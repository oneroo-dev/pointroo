{
  "name": "pointroo-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Pointroo screens on @roo/kit. Mockups first (mockups/), the approved ones move into src/ as they are.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "mockups": "node --import ./scripts/register-resolve.mjs ./scripts/mockups.mjs serve",
    "mockups:build": "node --import ./scripts/register-resolve.mjs ./scripts/mockups.mjs build",
    "kit:strict": "node ${ONEROO_ROOT:-$HOME/Workspace/oneroo}/tools/kit-strict.mjs --app .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@roo/kit": "file:vendor/roo-kit.tgz",
    "reka-ui": "^2.4.1",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "playwright-core": "^1.65.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
